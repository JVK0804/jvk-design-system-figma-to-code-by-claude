{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "heritage-cream":     { "$value": "#E8E4D9", "$type": "color" },
    "cream-bright":       { "$value": "#F5F2EB", "$type": "color" },
    "cream-shadow":       { "$value": "#D4CFBF", "$type": "color" },
    "primary":            { "$value": "#0E7490", "$type": "color" },
    "primary-hover":      { "$value": "#22B8CF", "$type": "color" },
    "primary-phosphor":   { "$value": "#A5F3FC", "$type": "color" },
    "primary-subtle":     { "$value": "rgba(14,116,144,0.10)", "$type": "color" },
    "primary-border":     { "$value": "rgba(14,116,144,0.28)", "$type": "color" },
    "ink":                { "$value": "#1C1A14", "$type": "color" },
    "ink-muted":          { "$value": "#5A5648", "$type": "color" },
    "ink-disabled":       { "$value": "#9A9488", "$type": "color" }
  },
  "spacing": {
    "1":  { "$value": "4px",   "$type": "spacing" },
    "2":  { "$value": "8px",   "$type": "spacing" },
    "3":  { "$value": "12px",  "$type": "spacing" },
    "4":  { "$value": "16px",  "$type": "spacing" },
    "6":  { "$value": "24px",  "$type": "spacing" },
    "8":  { "$value": "32px",  "$type": "spacing" },
    "12": { "$value": "48px",  "$type": "spacing" },
    "20": { "$value": "80px",  "$type": "spacing" },
    "28": { "$value": "112px", "$type": "spacing" }
  },
  "borderRadius": {
    "sm":   { "$value": "4px",   "$type": "borderRadius" },
    "md":   { "$value": "8px",   "$type": "borderRadius" },
    "lg":   { "$value": "14px",  "$type": "borderRadius" },
    "xl":   { "$value": "20px",  "$type": "borderRadius" },
    "pill": { "$value": "100px", "$type": "borderRadius" }
  },
  "typography": {
    "display":  { "$value": { "fontSize": "80px",  "fontWeight": 200, "letterSpacing": "-0.05em", "lineHeight": 1.0  }, "$type": "typography" },
    "h1":       { "$value": { "fontSize": "52px",  "fontWeight": 200, "letterSpacing": "-0.04em", "lineHeight": 1.1  }, "$type": "typography" },
    "h2":       { "$value": { "fontSize": "28px",  "fontWeight": 400, "letterSpacing": "-0.03em", "lineHeight": 1.2  }, "$type": "typography" },
    "h3":       { "$value": { "fontSize": "20px",  "fontWeight": 500, "letterSpacing": "-0.02em", "lineHeight": 1.3  }, "$type": "typography" },
    "body":     { "$value": { "fontSize": "16px",  "fontWeight": 400, "letterSpacing": "-0.01em", "lineHeight": 1.75 }, "$type": "typography" },
    "caption":  { "$value": { "fontSize": "13px",  "fontWeight": 400, "letterSpacing": "0em",     "lineHeight": 1.5  }, "$type": "typography" },
    "label":    { "$value": { "fontSize": "11px",  "fontWeight": 500, "letterSpacing": "+0.08em",  "lineHeight": 1.4  }, "$type": "typography" },
    "terminal": { "$value": { "fontSize": "13px",  "fontWeight": 400, "letterSpacing": "+0.12em",  "lineHeight": 1.6  }, "$type": "typography" }
  },
  "animation": {
    "haptic-press":  { "$value": { "duration": "30ms",  "scale": 0.955, "easing": "cubic-bezier(0.4,0,1,1)" }, "$type": "transition" },
    "haptic-return": { "$value": { "duration": "280ms", "scale": 1.018, "stiffness": 520, "damping": 22, "mass": 0.6 }, "$type": "transition" }
  }
}
